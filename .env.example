# ---------------------------------------------------------------------------
# Kliqtape — Beispielkonfiguration.
# Kopieren nach .env und anpassen. Die echte .env gehoert NIE ins Repo.
# ---------------------------------------------------------------------------

# Zeitzone fuer alle Container. Ohne das laufen sie auf UTC und die
# Zeitstempel im Feed weichen von der Wanduhr ab.
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Netzwerk
# ---------------------------------------------------------------------------

# Auf welcher Adresse der Webserver lauscht.
#   127.0.0.1 = nur lokal, Zugriff von aussen ausschliesslich ueber Tailscale (empfohlen)
#   0.0.0.0   = im ganzen LAN erreichbar. ACHTUNG: dann ist es http, und
#               ohne https geben Browser Kamera und Mikrofon nicht frei.
BIND_ADDR=127.0.0.1
HTTP_PORT=8099

# ---------------------------------------------------------------------------
# Tailscale-Sidecar
# ---------------------------------------------------------------------------

# Hostname im Tailnet -> https://<TS_HOSTNAME>.<dein-tailnet>.ts.net
TS_HOSTNAME=kliqtape

# Auth-Key aus der Tailscale-Admin-Konsole (Settings -> Keys).
# Niemals hardcoden, niemals committen. Am besten als Ephemeral+Reusable Key.
# Wenn du Tailscale nicht nutzen willst: den Service tailscale in der
# docker-compose.yml auskommentieren, dann wird diese Variable nicht gebraucht.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Oeffentlicher Zugang (Caddy) — nur noetig mit "docker compose --profile public up"
# ---------------------------------------------------------------------------

# Eigene Domain, muss schon auf die Server-IP zeigen, bevor Caddy startet —
# sonst bekommt es kein Let's-Encrypt-Zertifikat.
DOMAIN=kliqtape.example.com

# Fuer Let's-Encrypt-Benachrichtigungen (z.B. falls ein Zertifikat mal nicht
# automatisch erneuert werden konnte).
ACME_EMAIL=du@example.com

# ---------------------------------------------------------------------------
# Medien
# ---------------------------------------------------------------------------

# Obergrenze pro Upload in MB. Ein 90-Sekunden-Mixtape in Opus liegt bei ~1 MB,
# ein 10-Sekunden-Video je nach Geraet bei 3-10 MB.
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Kliqtape-Kanal
# ---------------------------------------------------------------------------

# Der einzige Name, der in den Kliqtape-Kanal posten darf (News/Insights,
# fuer alle sichtbar, egal in welcher Kassette). Muss zuerst ganz normal in
# der App ueber die Namenseingabe beansprucht werden (wie jeder andere
# Name), erst danach kann diese Person dort posten. Leer lassen, bis du dich
# entschieden hast — der Kanal ist dann fuer alle sichtbar, aber leer.
ADMIN_NAME=

# ---------------------------------------------------------------------------
# Einladungsbrief
# ---------------------------------------------------------------------------

# Adresse, die im QR-Code eines Einladungsbriefs steht, z.B.
# https://kliqtape.example.com — leer = die Adresse, von der aus der Brief
# angefordert wurde.
PUBLIC_URL=

# ---------------------------------------------------------------------------
# Vorfuehrung
# ---------------------------------------------------------------------------

# 1 = jeder Typ der Wochen-Challenge laesst sich sofort starten und der
# Sonntagabend vorziehen (auch die Imposter-Woche). Nur fuer Demos, im
# echten Betrieb leer lassen.
DEMO_TOOLS=
